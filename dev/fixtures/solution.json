      {
        "filename": "food-chain.js",
        "content": "module.exports = (function() {\n  // A comment, to check that italics survive the round trip.\n  const verseLyrics = [];\n  verseLyrics[1] = \"I know an old lady who swallowed a fly.\\nI don't know why she swallowed the fly. Perhaps she'll die.\\n\";\n\n  function swallow(animal, { wriggled = false } = {}) {\n    if (!animal) { return null; }\n    return `She swallowed the ${animal}` + (wriggled ? \" that wriggled\" : \"\");\n  }\n\n  return { swallow, verseLyrics };\n})();"
      }
    ]
  },

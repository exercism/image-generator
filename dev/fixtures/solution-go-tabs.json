        "content": "package foodchain\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n)\n\n// Verse returns a single verse of the song.\nfunc Verse(v int) string {\n\tif v == 1 {\n\t\treturn \"I know an old lady who swallowed a fly. I don't know why she swallowed the fly. Perhaps she'll die.\"\n\t}\n\n\tvar sb strings.Builder\n\tfor i := v; i > 0; i-- {\n\t\tif i > 1 {\n\t\t\tsb.WriteString(fmt.Sprintf(\"She swallowed the %s to catch the %s.\", animals[i], animals[i-1]))\n\t\t}\n\t}\n\n\treturn sb.String()\n}\n"
      }
    ]

        "filename": "mixed_scripts.py",
        "content": "# Mixed-script rendering check - every line here tofud before the\n# CJK and emoji fallback faces were added.\n\nimport unicodedata\n\nGREETINGS = {\n    \"ja\": \"こんにちは世界\",      # Japanese: kana + ideographs\n    \"zh\": \"你好，世界\",         # Simplified Chinese, CJK punctuation\n    \"ko\": \"안녕하세요\",          # Korean Hangul\n    \"ru\": \"Привет, мир\",       # Cyrillic, already covered\n    \"el\": \"Γειά σου Κόσμε\",    # Greek, already covered\n    \"vi\": \"Xin chào thế giới\", # Vietnamese, already covered\n}\n\n# Emoji are monochrome here: Noto Emoji is a CBDT-free outline font,\n# because resvg will not draw colour emoji tables. 🚀 ✅ 🎉 ⚡ 🔥\nSTATUS = {\"pass\": \"✅\", \"fail\": \"❌\", \"ship\": \"🚀\"}\n\ndef greet(lang: str) -> str:\n    \"\"\"全角文字 and ｈａｌｆｗｉｄｔｈ forms in a docstring.\"\"\"\n    return f\"{GREETINGS[lang]} {STATUS[pass]}\"\n\nassert greet(\"ja\") == \"こんにちは世界 ✅\""
      }
    ]
  },
